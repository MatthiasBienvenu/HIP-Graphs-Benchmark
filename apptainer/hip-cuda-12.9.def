Bootstrap: docker
From: nvidia/cuda:12.9.2-devel-ubuntu24.04

%labels
    Author "Matthias Bienvenu"
    Description "CUDA + HIP-NVIDIA development container"

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        wget \
        gnupg \
        equivs \
        cmake

    wget https://repo.radeon.com/rocm/rocm.gpg.key
    gpg --dearmor -o /usr/share/keyrings/rocm.gpg rocm.gpg.key

    echo "deb [signed-by=/usr/share/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/7.2.4 noble main" \
        > /etc/apt/sources.list.d/rocm.list

    apt-get update

    # CUDA toolkit already exists from nvidia/cuda image
    apt-get install -y cuda-toolkit-12-9

    # satisfy hip-runtime-nvidia dependency without pulling CUDA 13 or nvidia drivers
    cat > cuda-control <<EOF
Section: misc
Priority: optional
Package: cuda
Version: 12.9.2
Architecture: amd64
Provides: cuda
Description: Dummy CUDA metapackage
EOF

    equivs-build cuda-control
    dpkg -i cuda_12.9.2_amd64.deb

    # I have to specify the hipcc version or it will install ubuntu's hipcc 5.7
    apt-get install -y --no-install-recommends \
        hip-runtime-nvidia \
        hip-dev
